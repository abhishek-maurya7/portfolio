{
  "collectionName": "components_shared_links",
  "info": {
    "displayName": "Link",
    "icon": "link"
  },
  "options": {},
  "attributes": {
    "label": {
      "type": "string",
      "required": true
    },
    "href": {
      "type": "string",
      "required": true
    },
    "target": {
      "type": "enumeration",
      "default": "_self",
      "enum": [
        "_self",
        "_blank",
        "_parent",
        "_top"
      ]
    },
    "rel": {
      "type": "string",
      "default": "noopener noreferrer"
    },
    "variant": {
      "type": "enumeration",
      "default": "primary",
      "enum": [
        "primary",
        "secondary",
        "tertiary"
      ]
    }
  },
  "config": {}
}
