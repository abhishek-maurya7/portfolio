{
  "name": "portfolio",
  "packageManager": "yarn@4.17.1",
  "workspaces": [
    "frontend",
    "cms"
  ],
  "scripts": {
    "dev": "yarn workspaces foreach -A -p -i -v run dev",
    "storybook": "yarn workspace frontend storybook",
    "build-storybook": "yarn workspace frontend build-storybook",
    "format:frontend": "yarn workspace frontend exec prettier --write .",
    "format:frontend:check": "yarn workspace frontend exec prettier --check ."
  }
}
