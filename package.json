{
  "name": "portfolio",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter frontend --filter cms run dev",
    "dev:frontend": "pnpm --filter frontend run dev",
    "dev:cms": "pnpm --filter cms run dev",
    "dev:storybook": "pnpm --filter frontend storybook",

    "build": "pnpm run build:frontend && pnpm run build:cms",
    "build:frontend": "pnpm --filter frontend run build",
    "build:cms": "pnpm --filter cms run build",
    "build-storybook": "pnpm --filter frontend run build-storybook",

    "format:frontend": "pnpm --filter frontend exec prettier --write .",
    "format:frontend:check": "pnpm --filter frontend exec prettier --check ."
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
